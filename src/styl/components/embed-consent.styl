.embed-consent-gate
  margin-top: 1rem
  margin-bottom: 1rem

.embed-consent-gate__placeholder
  background: var(--color-gray-light)
  border: 1px solid var(--color-gray)
  border-radius: var(--corner-radius)
  display: flex
  align-items: center
  justify-content: center
  min-height: 100px
  padding: 1.5rem

.embed-consent-gate__content
  max-width: 400px
  text-align: center

.embed-consent-gate__message
  margin-bottom: 1rem

.embed-consent-gate__accept
  display: block
  margin: 0 auto 0.75rem

// Nested under the gate so this outranks `.text-copy a` (blue) when the gate
// sits inside post content. Solid black-soft on the grey placeholder: the
// previous faded link fell below AA contrast at this size.
.embed-consent-gate .embed-consent-gate__privacy-link
  display: block
  text-decoration: underline
  color: var(--color-black-soft)
