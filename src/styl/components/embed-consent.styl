.embed-consent-gate
  margin-top: 1rem
  margin-bottom: 1rem

.embed-consent-gate__placeholder
  background: var(--color-gray-light)
  border: 1px solid var(--color-gray)
  border-radius: 4px
  display: flex
  align-items: center
  justify-content: center
  min-height: 100px
  padding: 1.5rem

.embed-consent-gate__content
  max-width: 400px
  text-align: center

.embed-consent-gate__message
  margin-bottom: 1rem

.embed-consent-gate__accept
  display: block
  margin: 0 auto 0.75rem

.embed-consent-gate__privacy-link
  display: block
  text-decoration: underline
  color: inherit
  opacity: 0.6
