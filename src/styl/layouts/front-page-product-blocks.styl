.front-page-novara-live__posts-scroller
  height: 400px
  .ux-scroller__fade-top, .ux-scroller__fade-bottom
    height: 60px

@media screen and (max-width: $breakpoint-s)
  .front-page-novara-live__posts-scroller
    height: auto
    .ux-scroller__fade-top, .ux-scroller__fade-bottom
      display: none
    .ux-scroller__inner
      > :nth-child(n+4)
        display: none

.front-page__acfm,
.front-page__audio-product
  height: 100%

.front-page__acfm-logo,
.front-page__audio-product-logo
  svg
    height: auto
    width: auto
    max-width: 250px
    max-height: 100px
    margin: 0 auto
    display: block

// Progressive enhancement: the build (sharp via image-minimizer) generates the
// .webp/.avif from the source .jpg into dist; the .avif/.webp/.fallback classes
// are set on <html> by the feature-detect script. cover/center/repeat are
// handled by the .background-cover-image library helper in the markup.
.avif .front-page-dyor
  background-image: url('./img/products/dyor/dyor-background.avif')

.webp .front-page-dyor
  background-image: url('./img/products/dyor/dyor-background.webp')

.fallback .front-page-dyor
  background-image: url('./img/products/dyor/dyor-background.jpg')

// No library helper for flex-end alignment (only .layout-flex-align-center).
.front-page-dyor__top-row
  align-items: flex-end

// DYOR ALT module (design-comparison block).
// Only properties with no library-helper equivalent live here; overflow,
// position, display and button white-space are handled by utility classes in
// the markup.

// Slim the banner to the overlay's content ratio: the exported PNG has a tall
// transparent top margin, so the overlay is anchored to the bottom and this
// crops the empty band. No utility exists for aspect-ratio.
.front-page-dyor-alt__banner
  aspect-ratio: 1410 / 180

.front-page-dyor-alt__banner-overlay
  position: absolute
  left: 0
  bottom: 0
  width: 100%
  height: auto

// flex-wrap + gap have no utility (layout-flex-justify-right covers only the
// justify); keep the whole rule together so the mobile justify override is
// same-selector and source-order reliable.
.front-page-dyor-alt__cta
  display: flex
  flex-wrap: wrap
  gap: 0.5rem
  justify-content: flex-end

  // .ui-button has a global white-space:nowrap, but it's overridden in this
  // context — restate it so the button labels never wrap mid-text.
  .ui-button
    white-space: nowrap

@media screen and (max-width: $breakpoint-s)
  .front-page-dyor-alt__cta
    justify-content: flex-start

  // Mobile swaps to the taller standard dyor-hero overlay (1410x561) — give the
  // banner a matching ratio so it sits at a comfortable height instead of skinny.
  .front-page-dyor-alt__banner
    aspect-ratio: 1410 / 561

.front-page__audio-product--novarafm
  .front-page__audio-product-logo
    svg
      path
        fill: var(--color-black-soft) !important

// THE CORTADO product block. Only properties with no library-helper equivalent
// live here; the ochre box, grid and spacing are utility classes in the markup.

// Wordmark is inlined so its currentColor fill can be set here. Sized by height so
// it tracks the type scale rather than an arbitrary width; the viewBox gives the width.
.front-page-cortado__wordmark
  color: var(--color-ochre)
  display: block

  svg
    display: block
    height: 2.75rem
    width: auto
    max-width: 100%

// Everything in the banner hangs from the top; only the presenters sit on the
// bottom edge, as drawn. No utility exists for per-item flex-end.
.front-page-cortado__presenters-col
  align-self: flex-end

.front-page-cortado__presenters
  display: block
  width: 100%
  height: auto

// Eyebrows and the archive link carry the brand colour.
.front-page-cortado__label
  color: var(--color-ochre)

// Card rules and avatar rings are black here, unlike the ochre on the archive.
.front-page-cortado
  .ui-border-top, .ui-circle-image
    --ui-border-color: var(--color-black-soft)
