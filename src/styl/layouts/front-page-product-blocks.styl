.front-page-novara-live__posts-scroller
  height: 400px
  .ux-scroller__fade-top, .ux-scroller__fade-bottom
    height: 60px

@media screen and (max-width: $breakpoint-s)
  .front-page-novara-live__posts-scroller
    height: auto
    .ux-scroller__fade-top, .ux-scroller__fade-bottom
      display: none
    .ux-scroller__inner
      > :nth-child(n+4)
        display: none

.front-page__acfm,
.front-page__audio-product
  height: 100%

.front-page__acfm-logo,
.front-page__audio-product-logo
  svg
    height: auto
    width: auto
    max-width: 250px
    max-height: 100px
    margin: 0 auto
    display: block

.avif .front-page-dyor
  background-image: url('./img/products/dyor/dyor-background.avif')

.webp .front-page-dyor
  background-image: url('./img/products/dyor/dyor-background.webp')

.fallback .front-page-dyor
  background-image: url('./img/products/dyor/dyor-background.jpg')

.front-page-dyor
  background-size: cover
  background-position: center

.front-page-dyor__top-row
  align-items: flex-end

// DYOR ALT module (design-comparison block).
// Only properties with no library-helper equivalent live here; overflow,
// position, display and button white-space are handled by utility classes in
// the markup.

// Slim the banner to the overlay's content ratio: the exported PNG has a tall
// transparent top margin, so the overlay is anchored to the bottom and this
// crops the empty band. No utility exists for aspect-ratio.
.front-page-dyor-alt__banner
  aspect-ratio: 1410 / 180

.front-page-dyor-alt__banner-overlay
  position: absolute
  left: 0
  bottom: 0
  width: 100%
  height: auto

// flex-wrap + gap have no utility (layout-flex-justify-right covers only the
// justify); keep the whole rule together so the mobile justify override is
// same-selector and source-order reliable.
.front-page-dyor-alt__cta
  display: flex
  flex-wrap: wrap
  gap: 0.5rem
  justify-content: flex-end

  // .ui-button has a global white-space:nowrap, but it's overridden in this
  // context — restate it so the button labels never wrap mid-text.
  .ui-button
    white-space: nowrap

@media screen and (max-width: $breakpoint-s)
  .front-page-dyor-alt__cta
    justify-content: flex-start

  // Mobile swaps to the taller standard dyor-hero overlay (1410x561) — give the
  // banner a matching ratio so it sits at a comfortable height instead of skinny.
  .front-page-dyor-alt__banner
    aspect-ratio: 1410 / 561

.front-page__audio-product--novarafm
  .front-page__audio-product-logo
    svg
      path
        fill: var(--color-black-soft) !important
