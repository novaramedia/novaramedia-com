.post-col12-image
  position: relative

.post-col12-image-overlay
  position: absolute
  bottom: 0
  left: 0
  top: 0
  right: 0
  background-image: linear-gradient(to bottom, rgba(0,0,0,0) 0%,rgba(0,0,0,0) 30%,rgba(0,0,0,0.5) 100%)

// Boxed variant of partials/post-layouts/archive-post-no-thumbnail.php. The article is a
// stretched flex grid-item, so filling it keeps a row of cards level whatever their
// title lengths. No library utility for a bare height: 100%.
.archive-post-no-thumbnail__box
  height: 100%
