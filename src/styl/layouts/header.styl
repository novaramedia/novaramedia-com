// @media screen and (max-width: $breakpoint-l)
//   html
//     --header-height: 46px

// @media screen and (max-width: $breakpoint-m)
//   html
//     --header-height: 46px

@media screen and (max-width: $breakpoint-s)
  html
    --header-height: 42px

  #menu-toggle, #search-toggle, #menu-logo
    padding: 0 2px
    .icon-menu:before
      margin: 0

  .site-header__logomark
    svg
      height: 15px
      width: 23px

// ******************************************************

// SITE NAV

.site-header-nav
  display: none
  a
    display: block
    padding: .25rem 0

@media screen and (max-width: $breakpoint-m)

  .site-header-nav
    height: unquote('calc(100vh - var(--header-height))')
    overflow-y: auto

// ******************************************************

// SEARCH

.site-header-search
  display: none
