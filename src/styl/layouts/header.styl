$header-height = 46px

html
  --header-height: 46px

.site-header
  position: fixed
  width: 100%
  z-index: 1000

#main-content
  padding-top: var(--header-height)
  min-height: 55vh

.site-header__wrapper
  height: var(--header-height)
  overflow: hidden
  display: flex
  align-items: center;

// Skip link: first focusable element on every page. Sits above the viewport
// until keyboard focus, then drops in over the fixed header.
.skip-link
  position: fixed
  top: 0
  left: 0
  z-index: 1001
  padding: .75rem 1rem
  background-color: var(--color-white-soft)
  color: var(--color-black-soft)
  transform: translateY(-100%)

  &:focus
    transform: none

// Toggles are <button>s for keyboard access; strip browser button chrome so
// they render the same as the plain list items they replaced.
.site-header__toggle
  margin: 0
  padding: 0 .25rem 0 0
  border: 0
  background: none
  color: inherit
  font: inherit
  line-height: inherit

@media screen and (max-width: $breakpoint-m)
  .site-header__toggle
    padding-right: .5rem

.icon-large:before
  font-size: 1.4rem

@media screen and (max-width: $breakpoint-s)
  .site-header__toggle
    padding-top: 12px
    padding-bottom: 10px

  .header-main__middle
    margin-top: 12px
    margin-bottom: 10px

.site-header__navigation
  user-select: none

.site-header__logomark
  position: relative
  transition: opacity var(--transition-speed-medium)
  margin-top: 2px
  svg
    height: 19px
    width: 23px

.site-header__scroll-reveal
  opacity: 0
  transition: opacity var(--transition-speed-medium)
  position: absolute
  left: 0.5em
  right: 0.5em
  top: 50%
  transform: translateY(-50%)

.site-header__scroll-reveal-text
  display: block

