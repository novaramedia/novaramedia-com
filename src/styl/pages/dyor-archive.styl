.dyor-archive
  --dyor-green: #10E920

// Hero
.avif .dyor-archive__hero-background
  background-image: url('./img/products/dyor/dyor-background.avif')

.webp .dyor-archive__hero-background
  background-image: url('./img/products/dyor/dyor-background.webp')

.fallback .dyor-archive__hero-background
  background-image: url('./img/products/dyor/dyor-background.jpg')

.dyor-archive__hero
  position: relative
  overflow: hidden

.dyor-archive__hero-image
  width: 100%
  max-width: 900px
  margin-left: auto
  margin-right: auto
  height: auto
  display: block
  aspect-ratio: 1410 / 561
  object-fit: cover

.dyor-archive__hero-overlay
  position: absolute
  inset: 0
  display: flex
  align-items: flex-end
  justify-content: center
  pointer-events: none

// Intro
.dyor-archive__intro-text
  max-width: 897px
  margin-left: auto
  margin-right: auto

.dyor-archive__intro-buttons
  display: flex
  gap: 1rem
  justify-content: center
  flex-wrap: wrap

@media screen and (max-width: $breakpoint-m)
  .dyor-archive__intro-buttons
    gap: 0.5rem

// Season map: a short banner with a centred button until clicked, then it
// opens to full map height with the Figma iframe filling it.
.dyor-archive__map
  position: relative
  flex: 1 1 100%
  display: flex
  align-items: center
  justify-content: center
  height: 160px
  background-color: var(--color-gray-light)
  overflow: hidden
  transition: height 0.4s ease

  iframe
    position: absolute
    inset: 0
    width: 100%
    height: 100%
    border: 1px solid rgba(0, 0, 0, 0.1)

  &.is-loaded
    height: clamp(450px, 70vh, 85vh)

    .dyor-archive__map-button
      display: none

@media screen and (max-width: $breakpoint-m)
  .dyor-archive__map
    height: 120px

    &.is-loaded
      height: 450px

@media (prefers-reduced-motion: reduce)
  .dyor-archive__map
    transition: none
