{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nm-wp/related-post",
	"version": "0.1.0",
	"title": "Related Post",
	"category": "widgets",
	"icon": "admin-links",
	"description": "Inline related post or event reference, rendered with a layout matching the linked content type.",
	"supports": {
		"html": false
	},
	"attributes": {
		"relatedPost": {
			"type": "object",
			"default": null
		}
	},
	"textdomain": "novaramedia-com",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php"
}
