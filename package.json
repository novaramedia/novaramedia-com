{
  "name": "novaramedia-com",
  "version": "4.8.0",
  "description": "No Future, Utopia Now",
  "main": "gulpfile.js",
  "scripts": {
    "test": "cypress run",
    "test:headed": "cypress run --headed",
    "test:chrome": "cypress run --browser chrome",
    "test:firefox": "cypress run --browser firefox",
    "cy:open": "cypress open",
    "cy:verify": "cypress verify",
    "dev": "webpack --mode=development",
    "dev:blocks": "wp-scripts start --config webpack.blocks.config.js --webpack-src-dir=src/blocks --output-path=blocks",
    "build:theme": "webpack --mode=production",
    "build:blocks": "wp-scripts build --config webpack.blocks.config.js --webpack-src-dir=src/blocks --output-path=blocks",
    "build": "npm run build:theme && npm run build:blocks",
    "release": "release-it",
    "release:ci": "./scripts/release.sh"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/novaramedia/novaramedia-com.git"
  },
  "author": "Novara Media",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/novaramedia/novaramedia-com/issues"
  },
  "homepage": "https://github.com/novaramedia/novaramedia-com",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@release-it/keep-a-changelog": "^8.0.0",
    "@wordpress/scripts": "^34.1.0",
    "autoprefixer": "^10.5.0",
    "babel-loader": "^10.1.1",
    "chalk": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.49.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "cssnano": "^8.0.2",
    "cypress": "^15.17.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-webpack-plugin": "^5.0.2",
    "file-loader": "^6.2.0",
    "image-minimizer-webpack-plugin": "^5.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "moment-locales-webpack-plugin": "^1.2.0",
    "postcss": "~8.5.3",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.3.1",
    "release-it": "^21.0.2",
    "sharp": "^0.35.1",
    "style-loader": "~4.0.0",
    "stylus": "^0.64.0",
    "stylus-native-loader": "~1.4.12",
    "svgo": "^4.0.2",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.107.2",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-cli": "^7.0.3",
    "webpack-notifier": "~1.15.0"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "markdown-it": "^14.1.2",
    "linkify-it": "^5.0.2",
    "uuid": "^11.1.1",
    "minimatch@3": "^3.1.5",
    "serialize-javascript": "^7.1.0"
  },
  "dependencies": {
    "jquery": "^4.0.0",
    "js-cookie": "~3.0.1",
    "lazysizes": "~5.3.2",
    "lodash": "~4.18.1",
    "luxon": "^3.7.2",
    "nm-stylus-library": "github:novaramedia/nm-stylus-library#v0.14.1",
    "swiper": "^12.1.3"
  },
  "release-it": {
    "git": {
      "commit": false,
      "tag": false,
      "push": false
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/keep-a-changelog": {
        "filename": "CHANGELOG.md"
      }
    },
    "hooks": {
      "before:release": "npm run build",
      "after:release": "perl -i -pe 's/\\Q${latestVersion}\\E/${version}/g' style.css"
    }
  }
}
